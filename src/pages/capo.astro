---
import Layout from "../layouts/layout.astro";
import logo from "../assets/kapo/logo.png";

const page = {
  title: "Школа капоэйры в городе Уфа",
  description:
    "Временная страница школы капоэйры в городе Уфа. Сайт находится в разработке, для связи доступны контактные номера.",
};
---

<Layout title={page.title} description={page.description}>
  <main class="capoeira-page" aria-labelledby="capoeira-title">
    <section class="capoeira-hero">
      <div class="capoeira-mark" aria-hidden="true">
        <div class="capoeira-mark__content">
          <img
            class="capoeira-mark__logo"
            src={logo.src}
            alt=""
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="capoeira-mark__ring"></span>
      </div>

      <div class="capoeira-content">
        <p class="capoeira-kicker">Cordao de Ouro Capoeira</p>
        <h1 id="capoeira-title">Школа капоэйры в&nbsp;городе Уфа</h1>
        <p class="capoeira-lead">Сайт находится в разработке</p>

        <div class="capoeira-contacts" aria-label="Контакты школы">
          <p>Для связи обращайтесь по номерам:</p>
          <div class="capoeira-contact-list">
            <span>номер 1</span>
            <span>номер 2</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .capoeira-page {
    --capoeira-green: #16853d;
    --capoeira-green-dark: #073a23;
    --capoeira-yellow: #f7d527;
    --capoeira-blue: #214f9d;
    --capoeira-ink: #0d1018;
    --capoeira-paper: #fffaf0;

    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(24px, 5vw, 64px);
    background:
      radial-gradient(
        circle at 18% 16%,
        rgba(247, 213, 39, 0.32),
        transparent 24%
      ),
      radial-gradient(
        circle at 84% 12%,
        rgba(33, 79, 157, 0.4),
        transparent 28%
      ),
      linear-gradient(135deg, rgba(22, 133, 61, 0.28), transparent 42%),
      var(--capoeira-green-dark);
    color: var(--capoeira-paper);
  }

  .capoeira-hero {
    position: relative;
    width: min(100%, 1080px);
    min-height: min(720px, calc(100vh - 48px));
    display: grid;
    grid-template-columns: minmax(220px, 0.62fr) minmax(0, 1.38fr);
    align-items: center;
    gap: clamp(28px, 6vw, 76px);
    overflow: hidden;
    padding: clamp(28px, 6vw, 72px);
    border: 3px solid rgba(255, 250, 240, 0.18);
    border-radius: 28px;
    background:
      linear-gradient(115deg, rgba(255, 250, 240, 0.1), transparent 34%),
      rgba(13, 16, 24, 0.64);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.34);
  }

  .capoeira-hero::before,
  .capoeira-hero::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .capoeira-hero::before {
    inset: 18px;
    border: 1px solid rgba(247, 213, 39, 0.24);
    border-radius: 22px;
  }

  .capoeira-hero::after {
    right: -90px;
    bottom: -150px;
    width: 420px;
    height: 420px;
    border: 34px solid rgba(247, 213, 39, 0.86);
    border-right-color: rgba(33, 79, 157, 0.9);
    border-bottom-color: rgba(22, 133, 61, 0.88);
    border-radius: 50%;
    transform: rotate(-16deg);
  }

  .capoeira-mark,
  .capoeira-content {
    position: relative;
    z-index: 1;
  }

  .capoeira-mark {
    aspect-ratio: 1;
    min-width: 220px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at center,
        rgba(255, 250, 240, 0.96) 0 62%,
        transparent 63%
      ),
      conic-gradient(
        from -20deg,
        var(--capoeira-green) 0 34%,
        var(--capoeira-yellow) 34% 67%,
        var(--capoeira-blue) 67% 100%
      );
  }

  .capoeira-mark__content {
    width: 80%;
    height: 80%;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 100px;
    }
  }

  .capoeira-mark__logo {
    position: relative;
    z-index: 1;
    width: 72%;
    max-height: 84%;
    object-fit: contain;
  }

  .capoeira-mark__ring {
    position: absolute;
    inset: 8%;
    display: block;
    border: 7px dashed var(--capoeira-yellow);
    border-radius: 50%;
    opacity: 0.92;
  }

  .capoeira-content {
    max-width: 620px;
  }

  .capoeira-kicker {
    width: fit-content;
    margin-bottom: clamp(14px, 2vw, 20px);
    padding: 8px 12px;
    border: 2px solid var(--capoeira-yellow);
    border-radius: 999px;
    background: rgba(247, 213, 39, 0.12);
    color: var(--capoeira-yellow);
    font-size: clamp(0.74rem, 1.5vw, 0.88rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    color: #ffffff;
    font-size: clamp(2.6rem, 4.8vw, 4.7rem);
    font-weight: 950;
    line-height: 0.92;
    text-transform: uppercase;
    text-shadow:
      0 5px 0 var(--capoeira-blue),
      0 12px 28px rgba(0, 0, 0, 0.36);
  }

  .capoeira-lead {
    width: fit-content;
    margin-top: clamp(22px, 4vw, 34px);
    padding: 10px 16px;
    border: 2px solid rgba(13, 16, 24, 0.9);
    border-radius: 16px;
    background: var(--capoeira-paper);
    color: var(--capoeira-ink);
    font-size: clamp(1.35rem, 3vw, 2.2rem);
    font-weight: 850;
    line-height: 1.15;
    box-shadow: 8px 8px 0 var(--capoeira-blue);
  }

  .capoeira-contacts {
    margin-top: clamp(22px, 4vw, 36px);
    color: rgba(255, 250, 240, 0.86);
    font-size: clamp(1rem, 2vw, 1.18rem);
  }

  .capoeira-contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  .capoeira-contact-list span {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border: 2px solid rgba(13, 16, 24, 0.9);
    border-radius: 14px;
    background: var(--capoeira-paper);
    color: var(--capoeira-ink);
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 900;
    box-shadow: 7px 7px 0 var(--capoeira-yellow);
  }

  @media (min-width: 821px) and (max-width: 1040px) {
    .capoeira-hero {
      grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1fr);
      gap: clamp(24px, 4vw, 42px);
    }

    .capoeira-mark {
      min-width: 180px;
    }

    h1 {
      max-width: 13ch;
      font-size: clamp(2.7rem, 6.2vw, 4rem);
    }
  }

  @media (max-width: 820px) {
    .capoeira-page {
      align-items: stretch;
      padding: 16px;
    }

    .capoeira-hero {
      min-height: calc(100vh - 32px);
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 24px;
      padding: 24px;
      text-align: center;
    }

    .capoeira-hero::after {
      width: 300px;
      height: 300px;
      right: -140px;
      bottom: -120px;
      border-width: 24px;
    }

    .capoeira-mark {
      width: min(64vw, 270px);
      min-width: 0;
    }

    .capoeira-kicker,
    .capoeira-lead,
    .capoeira-contact-list {
      margin-right: auto;
      margin-left: auto;
    }

    h1 {
      max-width: 10ch;
      margin-right: auto;
      margin-left: auto;
    }

    .capoeira-contact-list {
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    .capoeira-hero {
      border-radius: 18px;
      padding: 20px;
    }

    .capoeira-hero::before {
      inset: 10px;
      border-radius: 14px;
    }

    .capoeira-contact-list {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .capoeira-mark__ring {
      animation: capoeira-spin 28s linear infinite;
    }
  }

  @keyframes capoeira-spin {
    to {
      transform: rotate(1turn);
    }
  }
</style>
